# ReceiptBox 环境变量（.env.example —— 复制为 .env 或设为 Space Secrets）

# ---- AWS Bedrock 提取大脑（可选；优先级最高，配了就走 Bedrock）----
# 手写 SigV4 直连 Bedrock Runtime，零第三方依赖
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=          # 仅临时凭据需要
AWS_REGION=us-east-1
RECEIPTBOX_BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# ---- LLM 提取大脑（可选；无 AWS 凭据时回退到此，再回退离线正则）----
# 任意 OpenAI 兼容端点（如 Nebius Token Factory / Vultr Inference / OpenAI）
RECEIPTBOX_LLM_BASE=
RECEIPTBOX_LLM_KEY=
RECEIPTBOX_LLM_MODEL=gpt-4o-mini

# ---- PayPal 收款链接（可选；不配则返回明确标注的演示深链）----
# 沙盒凭据：developer.paypal.com → My Apps & Credentials → Sandbox
RECEIPTBOX_PAYPAL_CLIENT_ID=
RECEIPTBOX_PAYPAL_SECRET=

# ---- 模拟 Alexa+ 体验（alexa_sim.py）----
# MCP server 地址（默认 http://127.0.0.1:7861/mcp）
RECEIPTBOX_MCP_URL=http://127.0.0.1:7861/mcp

# ---- MCP HTTP server（receiptbox.http_mcp）----
RECEIPTBOX_MCP_HOST=0.0.0.0
RECEIPTBOX_MCP_PORT=7861
RECEIPTBOX_MCP_PATH=/mcp
